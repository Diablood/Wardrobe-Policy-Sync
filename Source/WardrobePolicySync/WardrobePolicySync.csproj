<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.1.0</Version>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.7</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' != '1.7'">net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">D:/SteamLibrary/steamapps/common/RimWorld</RimWorldDir>
    <ManagedDir Condition="'$(RimWorldVersion)' == '1.7'">$(RimWorldDir)</ManagedDir>
    <ManagedDir Condition="'$(RimWorldVersion)' != '1.7'">$(RimWorldDir)/RimWorldWin64_Data/Managed</ManagedDir>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(RimWorldDir)/../../workshop/content/294100/2009463077/$(RimWorldVersion)/Assemblies/0Harmony.dll</HarmonyPath>
    <OutputPath>../../$(RimWorldVersion)/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>WardrobePolicySync</AssemblyName>
    <RootNamespace>WardrobePolicySync</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <Reference Include="UnityStubs"><HintPath>$(ManagedDir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' != '1.7'">
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
